# 复制本文件为 .env.tts（同目录）后，npm run web 会自动加载；
# 已存在的真实环境变量优先级更高（例如 PowerShell 里 $env:SAKTHAI_BASE_URL 会覆盖这里）。
TTS_TIMEOUT_MS=120000
TTS_HEALTH_TIMEOUT_MS=1500
EDGE_TTS_TIMEOUT_MS=30000
# 如果网络需要代理，取消下一行注释并修改端口
# EDGE_TTS_PROXY=http://127.0.0.1:7890

# 以下 BASE_URL / MODEL / VOICES 必须与 src/config/tts.config.json 保持一致：
# 这里设置的值会覆盖配置文件中的默认值，端口或模型名写错会导致该引擎在 UI 中被标记为不可用。
VOXCPM2_BASE_URL=http://127.0.0.1:10001
VOXCPM2_MODEL=VoxCPM2
VOXCPM2_VOICES=default

MOSS_TTS_BASE_URL=http://127.0.0.1:10002
MOSS_TTS_MODEL=moss-tts
MOSS_TTS_VOICES=default

KOKORO_BASE_URL=http://127.0.0.1:10003
KOKORO_MODEL=kokoro-thai
KOKORO_VOICES=speaker_00,speaker_01,speaker_02,speaker_03

SAKTHAI_BASE_URL=http://127.0.0.1:10004
SAKTHAI_MODEL=sakthai
SAKTHAI_VOICES=default

# Web UI 端口
PORT=3001
